# ============================================================
#  NCU-Human-AI-Programming  .gitignore
#  作用：告诉 Git「哪些文件不需要纳入版本管理」
#  规则：以 # 开头的是注释；结尾带 / 表示目录；! 表示例外（不忽略）
# ============================================================

# ---------- 1. 操作系统自动生成的垃圾文件 ----------
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini

# ---------- 2. 编辑器 / IDE 配置 ----------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.sublime-workspace
*~

# ---------- 3. Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# ---------- 4. 虚拟环境（每个同学电脑上都不一样，不能提交） ----------
venv/
.venv/
env/
ENV/
.python-version

# ---------- 5. Jupyter Notebook 检查点 ----------
.ipynb_checkpoints/
*.ipynb_checkpoints

# ---------- 6. Node.js / 前端 ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.cache/
.next/
.nuxt/
dist/
coverage/

# ---------- 7. 密钥与隐私（最重要的一条：绝对不要上传！） ----------
.env
.env.*
!.env.example
*.key
*.pem
secrets.json
credentials.json
config.local.*

# ---------- 8. 日志与临时文件 ----------
*.log
logs/
tmp/
temp/
*.tmp
*.bak

# ---------- 9. 大模型权重与大数据文件（动辄几个 G，GitHub 放不下） ----------
*.pt
*.pth
*.onnx
*.h5
*.ckpt
*.safetensors
*.bin

# ---------- 10. 运行产物 / 中间结果 ----------
outputs/
results/
data/raw/
*.csv.bak

# ---------- 11. 压缩包 ----------
*.zip
*.tar
*.tar.gz
*.rar
*.7z
